// Cloudflare Worker for the website (built with OpenNext: npm run deploy).
// Custom domains maqdoomsbigmall.com and www.maqdoomsbigmall.com are attached to this Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbm-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mbm-website"
    }
  ]
}
