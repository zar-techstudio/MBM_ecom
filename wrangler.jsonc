// Cloudflare Worker for the website (built with OpenNext: npm run deploy).
// Custom domains maqdoomsbigmall.com and www.maqdoomsbigmall.com are attached to this Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbm-website",
  "main": "worker.ts", // redirects plain http to https, then runs .open-next/worker.js
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // The deployed version's id: part of the key of the edge copy of pages (worker.ts), so a deploy
  // never serves pages that point to the previous build's files.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mbm-website"
    }
  ]
}
